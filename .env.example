# Optional: different inbox for correction forms (default is set in src/config.ts)
# VITE_MAINTAINER_EMAIL=you@example.com

# Optional: GitHub Pages base path
# VITE_SITE_BASE=/portsmouthbadmintonhub/

# Optional: visitor analytics (pick one or both). For live site, set the same names as
# GitHub repo Variables (Settings → Secrets and variables → Actions → Variables).
#
# GoatCounter — free, privacy-friendly dashboard: https://www.goatcounter.com
# Use the full count URL from your site settings, e.g. https://yoursite.goatcounter.com/count
# VITE_GOATCOUNTER_ENDPOINT=https://yoursite.goatcounter.com/count
#
# Google Analytics 4 measurement ID (optional alternative)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
